# Generate both secrets locally; never commit .env. Keep FRAY_SECRET_KEY stable.
FRAY_SECRET_KEY=replace-with-at-least-50-random-characters
POSTGRES_PASSWORD=replace-with-a-different-random-password
POSTGRES_DB=fray
POSTGRES_USER=fray
FRAY_PORT=8000
FRAY_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
FRAY_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
FRAY_DEBUG=false
# Local use only: verification/reset emails appear in `docker compose logs web`.
# Treat logs as sensitive. For real email choose smtp.EmailBackend and configure below.
FRAY_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Fray <no-reply@example.com>
# For HTTPS hosting, set both true and configure hosts/origins above.
FRAY_COOKIE_SECURE=false
FRAY_SSL_REDIRECT=false
