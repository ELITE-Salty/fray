# Local development only. Export these variables; Django does not auto-load .env.
FRAY_DEBUG=1
FRAY_HOSTS=localhost,127.0.0.1
FRAY_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Future production: set FRAY_DEBUG=0, generate independent secrets, use PostgreSQL
# and Redis on private/loopback interfaces, put HTTPS Nginx in front of Gunicorn.
# FRAY_SECRET_KEY=<random-django-secret>
# FRAY_MFA_KEY=<Fernet.generate_key().decode()>
# FRAY_DB_NAME=fray
# FRAY_DB_USER=fray
# FRAY_DB_PASSWORD=<random-password>
# FRAY_REDIS_URL=redis://127.0.0.1:6379/0
# FRAY_HOSTS=fray.example.org
# FRAY_ORIGINS=https://fray.example.org

# Production self-service signup (Mailjet SMTP). Verify your sender in Mailjet.
# FRAY_SIGNUP_ENABLED=1
# FRAY_EMAIL_HOST=in-v3.mailjet.com
# FRAY_EMAIL_PORT=587
# FRAY_EMAIL_USE_TLS=1
# FRAY_EMAIL_USE_SSL=0
# FRAY_EMAIL_USER=<Mailjet API key>
# FRAY_EMAIL_PASSWORD=<Mailjet secret key>
# FRAY_EMAIL_FROM=Fray <your-verified-sender@example.org>
# FRAY_SIGNUP_EMAIL_LIMIT=100
