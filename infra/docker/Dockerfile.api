FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && groupadd --gid 10001 fray \
    && useradd --uid 10001 --gid fray --no-create-home fray
COPY backend/ ./
USER 10001:10001
EXPOSE 8000
# A single threaded worker keeps Prometheus's in-process counters consistent.
CMD ["gunicorn", "fray.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "1", "--threads", "4", "--timeout", "60", "--access-logfile", "-", "--error-logfile", "-", "--worker-tmp-dir", "/tmp"]
